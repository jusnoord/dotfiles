{
  "github.copilot.nextEditSuggestions.enabled": true,
  "files.autoSave": "afterDelay",
  "redhat.telemetry.enabled": false,
  "git.openRepositoryInParentFolders": "always",
  "[plaintext]": {
    "editor.wordWrap": "on",
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "editor.unicodeHighlight.invisibleCharacters": false
  },
  "dev.containers.dockerCredentialHelper": false,
  "C_Cpp.default.compilerPath": "/usr/bin/g++",
  "chat.tools.urls.autoApprove": {
    "https://code.visualstudio.com": true,
    "https://github.com/microsoft/vscode/wiki/*": true,
    "https://docs.ros.org": true,
    "https://github.com": {
      "approveRequest": false,
      "approveResponse": true
    }
  },
  "python.analysis.typeCheckingMode": "basic",
  "chat.tools.terminal.autoApprove": {
    "colcon": true
  },
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
    "python": false
  },
  "explorer.confirmDragAndDrop": false,
  "claudeCode.preferredLocation": "panel",
  "workbench.colorCustomizations": {
    "editor.background": "#151218",
    "editor.foreground": "#e8e0e8",
    "editorCursor.foreground": "#e8e0e8",
    "editor.selectionBackground": "#221e24",
    "editor.lineHighlightBackground": "#1e1a20",
    "editorLineNumber.foreground": "#2c292e",
    "editorLineNumber.activeForeground": "#968e98",
    "editorWidget.background": "#1e1a20",
    "editorWhitespace.foreground": "#221e24",
    "sideBar.background": "#201b24",
    "sideBar.foreground": "#e8e0e8",
    "sideBarSectionHeader.background": "#201b24",
    "activityBar.background": "#201b24",
    "activityBar.foreground": "#e8e0e8",
    "activityBar.inactiveForeground": "#2c292e",
    "activityBar.activeBorder": "#dab9f9",
    "activityBarBadge.background": "#dab9f9",
    "activityBarBadge.foreground": "#151218",
    "statusBar.background": "#201b24",
    "statusBar.foreground": "#e8e0e8",
    "statusBar.noFolderBackground": "#201b24",
    "statusBar.debuggingBackground": "#d0c1da",
    "titleBar.activeBackground": "#201b24",
    "titleBar.activeForeground": "#e8e0e8",
    "titleBar.inactiveBackground": "#201b24",
    "titleBar.inactiveForeground": "#2c292e",
    "tab.activeBackground": "#151218",
    "tab.inactiveBackground": "#201b24",
    "tab.activeForeground": "#e8e0e8",
    "tab.inactiveForeground": "#968e98",
    "tab.border": "#1e1a20",
    "tab.activeBorderTop": "#dab9f9",
    "editorGroupHeader.tabsBackground": "#201b24",
    "panel.background": "#151218",
    "panel.border": "#221e24",
    "panelTitle.activeForeground": "#e8e0e8",
    "terminal.background": "#151218",
    "terminal.foreground": "#e8e0e8",
    "terminal.ansiBlack": "#151218",
    "terminal.ansiRed": "#ffb4ab",
    "terminal.ansiGreen": "#dab9f9",
    "terminal.ansiYellow": "#d0c1da",
    "terminal.ansiBlue": "#dab9f9",
    "terminal.ansiMagenta": "#d0c1da",
    "terminal.ansiCyan": "#f3b7be",
    "terminal.ansiWhite": "#e8e0e8",
    "terminal.ansiBrightBlack": "#2c292e",
    "terminal.ansiBrightRed": "#ffb4ab",
    "terminal.ansiBrightGreen": "#dab9f9",
    "terminal.ansiBrightYellow": "#d0c1da",
    "terminal.ansiBrightBlue": "#dab9f9",
    "terminal.ansiBrightMagenta": "#d0c1da",
    "terminal.ansiBrightCyan": "#f3b7be",
    "terminal.ansiBrightWhite": "#332f35",
    "focusBorder": "#dab9f9",
    "input.background": "#1e1a20",
    "dropdown.background": "#1e1a20",
    "list.activeSelectionBackground": "#221e24",
    "list.activeSelectionForeground": "#e8e0e8",
    "list.hoverBackground": "#1e1a20",
    "button.background": "#dab9f9",
    "button.foreground": "#151218",
    "badge.background": "#dab9f9",
    "badge.foreground": "#151218"
  },
  "workbench.colorTheme": "NoctaliaTheme",
  "C_Cpp.intelliSenseEngine": "disabled",
  "git.blame.editorDecoration.enabled": true,
  "explorer.confirmDelete": false,
  "editor.largeFileOptimizations": false
}
