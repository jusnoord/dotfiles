#!/usr/bin/env bash
# pin-package -- pin a nixpkgs package to a newer upstream release.
#
#   pin-package aome510/spotify-player 0.25.1
#   pin-package https://github.com/aome510/spotify-player 0.25.1 --attr spotify-player
#
# Generates nixos/overlays/<attr>.nix, then resolves every hash by building and
# reading the mismatch back out of Nix's error. The overlay directory is
# auto-imported, so nothing else needs editing. Delete the generated file when
# the rebuild warning says nixpkgs has caught up.
set -euo pipefail

FLAKE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OVERLAY_DIR="$FLAKE_DIR/overlays"
MAX_ROUNDS=6

die() { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }
note() { printf '\033[34m==>\033[0m %s\n' "$*" >&2; }

usage() {
  sed -n '2,10p' "${BASH_SOURCE[0]}" | sed 's/^# \?//'
  echo
  echo "options:"
  echo "  --attr NAME     nixpkgs attribute to override (default: repo name)"
  echo "  --tag TAG       exact git tag (default: autodetect vVERSION or VERSION)"
  echo "  --force         overwrite an existing overlay for this attribute"
  exit "${1:-0}"
}

case "${1:-}" in -h|--help|"") usage 0 ;; esac
[[ $# -ge 2 ]] || die "need a repo and a version (see --help)"

REPO_ARG="$1"; VERSION="$2"; shift 2
ATTR=""; TAG=""; FORCE=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --attr) ATTR="$2"; shift 2 ;;
    --tag)  TAG="$2";  shift 2 ;;
    --force) FORCE=1;  shift ;;
    -h|--help) usage 0 ;;
    *) die "unknown option: $1" ;;
  esac
done

# github URL, git@ URL or owner/repo -> owner + repo
SLUG="${REPO_ARG#*github.com[:/]}"
SLUG="${SLUG#https://github.com/}"
SLUG="${SLUG#git@github.com:}"
SLUG="${SLUG%.git}"
SLUG="${SLUG%/}"
[[ "$SLUG" == */* ]] || die "cannot parse a owner/repo out of '$REPO_ARG'"
OWNER="${SLUG%%/*}"
REPO="${SLUG#*/}"
[[ -n "$ATTR" ]] || ATTR="$REPO"

OUT="$OVERLAY_DIR/$ATTR.nix"
if [[ -e "$OUT" && $FORCE -eq 0 ]]; then
  die "$OUT already exists (pass --force to replace it)"
fi

note "attribute: $ATTR   repo: $OWNER/$REPO   version: $VERSION"

# Does the attribute exist, and is it a Rust package with a vendored cargo dir?
CURRENT="$(nix eval --raw "$FLAKE_DIR#nixosConfigurations.nixos.pkgs.$ATTR.version" 2>/dev/null)" \
  || die "pkgs.$ATTR does not exist (or has no version attribute)"
note "nixpkgs currently has $ATTR $CURRENT"

IS_RUST=0
if nix eval --raw "$FLAKE_DIR#nixosConfigurations.nixos.pkgs.$ATTR.cargoDeps.outPath" >/dev/null 2>&1; then
  IS_RUST=1
  note "detected a Rust package; will re-vendor cargo dependencies"
fi

# Pick the tag that actually exists upstream.
if [[ -z "$TAG" ]]; then
  TAGS="$(git ls-remote --tags "https://github.com/$OWNER/$REPO" 2>/dev/null || true)"
  if grep -q "refs/tags/v$VERSION\$" <<<"$TAGS"; then
    TAG="v$VERSION"
  elif grep -q "refs/tags/$VERSION\$" <<<"$TAGS"; then
    TAG="$VERSION"
  else
    die "neither tag 'v$VERSION' nor '$VERSION' exists in $OWNER/$REPO (use --tag)"
  fi
fi
TAG_EXPR="${TAG/$VERSION/\$\{version\}}"
note "using tag $TAG"

mkdir -p "$OVERLAY_DIR"
{
  cat <<EOF
# $ATTR pinned ahead of nixpkgs (nixpkgs had $CURRENT when this was generated).
# Generated by scripts/pin-package. Delete this file once the rebuild warning
# from ./_pin.nix says nixpkgs has caught up.
final: prev:

let
  pin = import ./_pin.nix;
  version = "$VERSION";
in
{
  $ATTR = pin prev "$ATTR" version (
    prev.$ATTR.overrideAttrs (finalAttrs: _prevAttrs: {
      inherit version;

      src = prev.fetchFromGitHub {
        owner = "$OWNER";
        repo = "$REPO";
        tag = "$TAG_EXPR";
        hash = prev.lib.fakeHash;
      };
EOF
  if [[ $IS_RUST -eq 1 ]]; then
    cat <<'EOF'

      # buildRustPackage derives cargoDeps from the *original* cargoHash, so a
      # bare src bump would keep vendoring against the old lockfile. Rebuild the
      # vendor dir explicitly against the new src instead.
      cargoDeps = prev.rustPlatform.fetchCargoVendor {
        inherit (finalAttrs) pname version src;
        hash = prev.lib.fakeHash;
      };
EOF
  fi
  cat <<'EOF'
    })
  );
}
EOF
} > "$OUT"

note "wrote ${OUT#"$FLAKE_DIR"/}"

# The flake lives inside a git repo, so Nix only sees tracked files.
git -C "$FLAKE_DIR" add -- "$OUT" >/dev/null 2>&1 || true

for ((round = 1; round <= MAX_ROUNDS; round++)); do
  grep -q 'prev\.lib\.fakeHash' "$OUT" || break
  note "resolving hash $round (this builds until the first mismatch; may take a while)"
  LOG="$(nix build --no-link "$FLAKE_DIR#nixosConfigurations.nixos.pkgs.$ATTR" 2>&1 || true)"
  GOT="$(grep -oE 'got: +sha256-[A-Za-z0-9+/=]+' <<<"$LOG" | tail -1 | grep -oE 'sha256-[A-Za-z0-9+/=]+' || true)"
  if [[ -z "$GOT" ]]; then
    printf '%s\n' "$LOG" >&2
    die "no hash mismatch reported -- see the build log above"
  fi
  note "  got $GOT"
  perl -0pi -e "s{prev\\.lib\\.fakeHash}{\"$GOT\"}" "$OUT"
done

if grep -q 'prev\.lib\.fakeHash' "$OUT"; then
  die "still unresolved hashes after $MAX_ROUNDS rounds"
fi

note "building $ATTR $VERSION"
nix build --no-link "$FLAKE_DIR#nixosConfigurations.nixos.pkgs.$ATTR" \
  || die "$ATTR $VERSION does not build unmodified; edit ${OUT#"$FLAKE_DIR"/} by hand"

NEW="$(nix eval --raw "$FLAKE_DIR#nixosConfigurations.nixos.pkgs.$ATTR.version")"
note "done: pkgs.$ATTR is now $NEW"
echo "$OUT"
